<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".screen.wind_detail.WindDetailFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/dp_16"
        android:background="#E2D3FA">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_scrollFlags="scroll|enterAlways">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/icBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="@id/tvTitle"
                    android:src="@drawable/ic_back"
                    app:tint="@color/black" />

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toEndOf="@id/icBack"
                    app:layout_constraintTop_toTopOf="parent"
                    android:text="@string/hanoi_vietnam"
                    android:textSize="@dimen/text_size_title_medium"
                    android:textStyle="bold"
                    android:layout_marginStart="@dimen/dp_24" />

                <ImageView
                    android:id="@+id/icSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="@id/tvTitle"
                    android:src="@drawable/ic_search"
                    app:tint="@color/black" />

                <ImageView
                    android:id="@+id/icMild"
                    android:layout_width="@dimen/dp_28"
                    android:layout_height="@dimen/dp_28"
                    android:src="@drawable/ic_mild"
                    android:layout_marginEnd="@dimen/dp_12"
                    app:layout_constraintStart_toEndOf="@id/icBack"
                    app:layout_constraintTop_toBottomOf="@id/icBack"
                    android:padding="@dimen/dp_4"
                    android:layout_marginTop="@dimen/dp_16"
                    android:background="@drawable/ic_bg_white" />

                <TextView
                    android:id="@+id/tvTemperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toEndOf="@id/icMild"
                    app:layout_constraintTop_toTopOf="@id/icMild"
                    app:layout_constraintBottom_toBottomOf="@id/icMild"
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/black"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="@dimen/dp_0"
                    android:layout_marginStart="@dimen/dp_8"
                    android:text="@string/temperature_label" />

                <TextView
                    android:id="@+id/tvCurrentTemperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/icMild"
                    app:layout_constraintStart_toStartOf="parent"
                    android:textSize="@dimen/text_size_temperature"
                    android:textColor="@color/black"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="@dimen/dp_0"
                    android:text="@string/home_current_temperature" />

                <TextView
                    android:id="@+id/tvFeelsLikeTemperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toEndOf="@id/tvCurrentTemperature"
                    app:layout_constraintBaseline_toBaselineOf="@id/tvCurrentTemperature"
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/black"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="@dimen/dp_0"
                    android:text="@string/home_feels_like_temperature" />

                <ImageView
                    android:id="@+id/icWeatherIcon"
                    android:layout_width="@dimen/weather_icon_size"
                    android:layout_height="@dimen/weather_icon_size"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/icMild"
                    app:layout_constraintBottom_toBottomOf="@id/tvCurrentTemperature"
                    android:src="@drawable/ic_cloud_and_sun"
                    android:layout_marginEnd="@dimen/dp_16" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/dp_16"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/dp_16"
                    android:background="@drawable/weather_card_detail">

                    <ImageView
                        android:id="@+id/icClock"
                        android:layout_width="@dimen/dp_28"
                        android:layout_height="@dimen/dp_28"
                        android:src="@drawable/ic_clock"
                        android:padding="@dimen/dp_4"
                        android:background="@drawable/ic_bg_white"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        android:id="@+id/tvPredictHour"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/black"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="@dimen/dp_0"
                        android:layout_marginStart="@dimen/dp_8"
                        app:layout_constraintStart_toEndOf="@id/icClock"
                        app:layout_constraintTop_toTopOf="@id/icClock"
                        app:layout_constraintBottom_toBottomOf="@id/icClock"
                        android:text="@string/hourly_forecast" />


                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerViewWindDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        android:scrollbars="horizontal"
                        android:clipToPadding="false"
                        android:padding="@dimen/dp_8"
                        android:layout_marginTop="@dimen/dp_8"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/icClock"
                        tools:itemCount="5"
                        tools:listitem="@layout/item_predict_temp"
                        />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <com.sun.weatherapp.screen.widget.ChartView
                    android:id="@+id/weatherChart"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/chart_height"
                    android:layout_marginTop="@dimen/dp_16"/>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_16"
                    android:background="@drawable/weather_card_detail">

                    <ImageView
                        android:id="@+id/icCalendar"
                        android:layout_width="@dimen/dp_28"
                        android:layout_height="@dimen/dp_28"
                        android:src="@drawable/ic_windy"
                        android:padding="@dimen/dp_4"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:background="@drawable/ic_bg_white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toEndOf="@id/icCalendar"
                        app:layout_constraintTop_toTopOf="@id/icCalendar"
                        app:layout_constraintBottom_toBottomOf="@id/icCalendar"
                        android:layout_marginStart="@dimen/dp_8"
                        android:text="@string/daily_summary"/>

                    <TextView
                        android:id="@+id/tvSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@id/icCalendar"
                        app:layout_constraintStart_toStartOf="parent"
                        android:padding="@dimen/dp_8"
                        android:layout_marginTop="@dimen/dp_8"
                        android:text="@string/sample_wind_summary"
                        android:background="@drawable/weather_card_background"
                        />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>