<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="@color/card_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Hero Section Skeleton -->
        <FrameLayout
            android:id="@+id/skeletonHeroSection"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:layout_margin="16dp"
            android:background="@drawable/skeleton_shimmer_background"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- Location Skeleton -->
            <View
                android:layout_width="200dp"
                android:layout_height="24dp"
                android:layout_gravity="top|start"
                android:layout_margin="16dp"
                android:background="@drawable/skeleton_shimmer_item" />

            <!-- Search Icon Skeleton -->
            <View
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="top|end"
                android:layout_margin="16dp"
                android:background="@drawable/skeleton_shimmer_item" />

            <!-- Temperature Section Skeleton -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginHorizontal="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Main Temperature -->
                    <View
                        android:layout_width="120dp"
                        android:layout_height="80dp"
                        android:background="@drawable/skeleton_shimmer_item"
                        android:layout_marginBottom="8dp" />

                    <!-- Feels Like -->
                    <View
                        android:layout_width="150dp"
                        android:layout_height="20dp"
                        android:background="@drawable/skeleton_shimmer_item" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <!-- Weather Icon -->
                    <View
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="@drawable/skeleton_shimmer_item"
                        android:layout_marginBottom="8dp" />

                    <!-- Weather Description -->
                    <View
                        android:layout_width="60dp"
                        android:layout_height="24dp"
                        android:background="@drawable/skeleton_shimmer_item" />

                </LinearLayout>

            </LinearLayout>

            <!-- Bottom Section Skeleton -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="horizontal"
                android:layout_margin="16dp">

                <!-- Time -->
                <View
                    android:layout_width="150dp"
                    android:layout_height="20dp"
                    android:background="@drawable/skeleton_shimmer_item" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Day/Night Temperature -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:layout_width="80dp"
                        android:layout_height="20dp"
                        android:background="@drawable/skeleton_shimmer_item"
                        android:layout_marginBottom="4dp" />

                    <View
                        android:layout_width="80dp"
                        android:layout_height="20dp"
                        android:background="@drawable/skeleton_shimmer_item" />

                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

        <!-- Weather Details Section Skeleton -->
        <LinearLayout
            android:id="@+id/skeletonDetailsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/weather_card_background"
            android:padding="20dp"
            app:layout_constraintTop_toBottomOf="@id/skeletonHeroSection">

            <!-- Section Title Skeleton -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="16dp">

                <View
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/skeleton_shimmer_item"
                    android:layout_marginEnd="12dp" />

                <View
                    android:layout_width="150dp"
                    android:layout_height="20dp"
                    android:background="@drawable/skeleton_shimmer_item" />

            </LinearLayout>

            <!-- Weather Details Items Skeleton -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Repeat this for 4 items -->
                <include layout="@layout/skeleton_weather_detail_item" />
                <include layout="@layout/skeleton_weather_detail_item" />
                <include layout="@layout/skeleton_weather_detail_item" />
                <include layout="@layout/skeleton_weather_detail_item" />

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
